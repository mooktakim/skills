#!/usr/bin/env ruby
# frozen_string_literal: true

# Checks and maintains the project memory under docs/, as docs/MEMORY.md
# describes. Plain Ruby, standard library only (Ruby 2.6+). Copied unchanged
# from the project-memory plugin; never edit the copy.
#
#   bin/memory lint            check notes, links, citations, log names, index,
#                              size budgets and secrets; exit 1 on any problem
#   bin/memory index [--check] write docs/INDEX.md from the notes' frontmatter;
#                              --check only reports whether it is current
#   bin/memory stale           list what a consolidation pass must look at:
#                              inbox proposals, notes past expire_after_days,
#                              lessons whose harmful count meets helpful
#
# Works from any directory: the project is the script's parent directory, or
# $MEMORY_ROOT when set. Settings come from docs/MEMORY.md's frontmatter.

require "date"

ROOT = File.expand_path(ENV["MEMORY_ROOT"] || File.join(__dir__, ".."))
DOCS = File.join(ROOT, "docs")
PROTOCOL = File.join(DOCS, "MEMORY.md")
INDEX = File.join(DOCS, "INDEX.md")
LESSONS = File.join(DOCS, "lessons.md")

TYPE_DIRS = {
  "convention" => "conventions",
  "architecture" => "architecture",
  "decision" => "decisions",
  "playbook" => "playbooks",
  "gotcha" => "gotchas"
}.freeze
TYPE_TITLES = {
  "conventions" => "Conventions",
  "architecture" => "Architecture",
  "decisions" => "Decisions",
  "playbooks" => "Playbooks",
  "gotchas" => "Gotchas"
}.freeze
STATUSES = %w[proposed active superseded expired].freeze
REQUIRED = %w[id type status summary created].freeze
DATE_FIELDS = %w[created verified_at valid_until].freeze
LIST_FIELDS = %w[aliases citations sources links].freeze
DEFAULTS = { "root_context_max_lines" => 150, "index_max_lines" => 200, "expire_after_days" => 90 }.freeze
GENERATED = "<!-- Generated by bin/memory index from the notes' frontmatter. Do not edit; run bin/memory index. -->"
SECRETS = {
  "an AWS access key" => /\b(?:AKIA|ASIA)[0-9A-Z]{16}\b/,
  "a private key" => /-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----/,
  "a GitHub token" => /\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,})\b/,
  "a Slack token" => /\bxox[abposr]-[A-Za-z0-9-]{10,}/,
  "a Stripe live key" => /\b[rs]k_live_[A-Za-z0-9]{20,}/,
  "an Anthropic API key" => /\bsk-ant-[A-Za-z0-9_-]{20,}/,
  "an OpenAI API key" => /\bsk-(?:proj-)?[A-Za-z0-9]{40,}/,
  "a Google API key" => /\bAIza[0-9A-Za-z_-]{35}\b/
}.freeze

Note = Struct.new(:path, :area, :folder, :fields, :errors, :body)
Lesson = Struct.new(:id, :title, :helpful, :harmful, :last_used, :line)

def rel(path)
  path.start_with?("#{ROOT}/") ? path[(ROOT.length + 1)..-1] : path
end

def docs_rel(path)
  path[(DOCS.length + 1)..-1]
end

# The frontmatter as a hash, plus errors for lines that are not `key: value`.
# Values are strings, or arrays for `[a, b]`; an empty value is nil. A comment
# after two or more spaces (`type: gotcha   # ...`) is dropped.
def parse_frontmatter(text)
  match = text.match(/\A---\n(.*?)\n?---\s*\n/m)
  return [nil, ["no frontmatter: a note starts with a --- block (see docs/MEMORY.md)"], text] unless match

  fields = {}
  errors = []
  match[1].each_line.with_index(2) do |line, number|
    line = line.chomp
    next if line.strip.empty?

    pair = line.match(/\A([a-z_]+):(.*)\z/)
    unless pair
      errors << "frontmatter line #{number} is not `key: value`"
      next
    end
    value = pair[2].sub(/(?:\A|\s{2,})#.*\z/, "").strip
    value = value[1..-2].split(",").map { |item| unquote(item.strip) }.reject(&:empty?) if value.start_with?("[") && value.end_with?("]")
    value = unquote(value) if value.is_a?(String)
    fields[pair[1]] = value.respond_to?(:empty?) && value.empty? ? nil : value
  end
  [fields, errors, match.post_match]
end

def unquote(text)
  text =~ /\A(["'])(.*)\1\z/ ? Regexp.last_match(2) : text
end

def settings
  @settings ||= begin
    fields = File.file?(PROTOCOL) ? (parse_frontmatter(File.read(PROTOCOL)).first || {}) : {}
    DEFAULTS.each_with_object({}) do |(key, default), out|
      out[key] = fields[key].to_s =~ /\A\d+\z/ ? fields[key].to_i : default
    end
  end
end

def notes
  @notes ||= begin
    folders = TYPE_DIRS.values + %w[inbox archive]
    files = folders.flat_map { |folder| Dir.glob(File.join(DOCS, folder, "**", "*.md")) }
    files.reject { |file| File.basename(file) == "INDEX.md" || docs_rel(file) == "archive/lessons.md" }.sort.map do |file|
      parts = docs_rel(file).split("/")
      area = parts[0]
      folder = area == "archive" && parts.size > 2 ? parts[1] : area
      fields, errors, body = parse_frontmatter(File.read(file))
      Note.new(file, area, folder, fields, errors, body)
    end
  end
end

def date?(value)
  value.is_a?(String) && value =~ /\A\d{4}-\d{2}-\d{2}\z/ && (Date.parse(value) rescue nil)
end

def note_problems(note, ids)
  return note.errors unless note.fields

  fields = note.fields
  problems = note.errors.dup
  REQUIRED.each { |key| problems << "missing #{key}" unless fields[key].is_a?(String) }
  LIST_FIELDS.each { |key| problems << "#{key} must be a list: [a, b]" if fields[key].is_a?(String) }
  DATE_FIELDS.each { |key| problems << "#{key} is not a date (YYYY-MM-DD): #{fields[key]}" if fields[key] && !date?(fields[key]) }
  type = fields["type"]
  status = fields["status"]
  problems << "unknown type #{type}: use one of #{TYPE_DIRS.keys.join(', ')}" if type && !TYPE_DIRS.key?(type)
  problems << "unknown status #{status}: use one of #{STATUSES.join(', ')}" if status && !STATUSES.include?(status)
  problems << "active notes need verified_at" if status == "active" && !fields["verified_at"]
  problems << "superseded notes need superseded_by" if status == "superseded" && !fields["superseded_by"]
  if fields["superseded_by"] && !ids.key?(fields["superseded_by"])
    problems << "superseded_by #{fields['superseded_by']} is not the id of any note"
  end
  case note.area
  when "inbox"
    problems << "only proposals belong in inbox/ (status is #{status})" if status && status != "proposed"
  when "archive"
    problems << "only superseded or expired notes belong in archive/ (status is #{status})" if %w[active proposed].include?(status)
  else
    problems << "status: proposed belongs in inbox/" if status == "proposed"
    problems << "#{status} notes belong in archive/" if %w[superseded expired].include?(status)
  end
  if TYPE_DIRS.key?(type) && note.area != "inbox" && TYPE_DIRS.key(note.folder) && TYPE_DIRS[type] != note.folder
    problems << "type #{type} belongs in #{TYPE_DIRS[type]}/"
  end
  unless note.area == "archive"
    Array(fields["citations"]).each { |citation| problems.concat(citation_problems(citation)) }
    Array(fields["links"]).each do |link|
      problems << "link #{link} does not exist" unless File.exist?(File.join(DOCS, link.sub(/#.*\z/, "")))
    end
    problems.concat(link_problems(note.path, note.body))
  end
  problems
end

def citation_problems(citation)
  match = citation.match(/\A(.+?)(?::(\d+)(?:-(\d+))?)?\z/)
  file = File.join(ROOT, match[1])
  return ["citation #{citation}: #{match[1]} does not exist"] unless File.file?(file)
  return [] unless match[2]

  lines = File.foreach(file).count
  last = (match[3] || match[2]).to_i
  return ["citation #{citation}: #{match[1]} has only #{lines} lines"] if last > lines || match[2].to_i < 1

  []
end

# Relative markdown links in the text that point at nothing. Fenced code is
# skipped, so examples of link syntax are not checked.
def link_problems(file, text)
  prose = text.gsub(/^(```|~~~).*?^\1[^\n]*$/m, "")
  prose.scan(/\[[^\]]*\]\(([^)\s]+)(?:\s+"[^"]*")?\)/).flatten.each_with_object([]) do |target, problems|
    next if target =~ %r{\A(?:[a-z][a-z0-9+.-]*:|#|/)}i

    path = target.sub(/#.*\z/, "")
    problems << "link #{target} does not exist" unless File.exist?(File.expand_path(path, File.dirname(file)))
  end
end

def lessons(file = LESSONS)
  return [[], []] unless File.file?(file)

  found = []
  problems = []
  current = nil
  File.foreach(file).with_index(1) do |line, number|
    if (head = line.match(/\A- \[(L-\d+)\]\s+(.+)/))
      problems << "lessons.md:#{current.line}: #{current.id} has no `helpful: N | harmful: N | last_used: ...` line" if current && !current.helpful
      current = Lesson.new(head[1], head[2].strip, nil, nil, nil, number)
      found << current
    elsif current && (counts = line.match(/\A\s+helpful:\s*(\d+)\s*\|\s*harmful:\s*(\d+)(?:\s*\|\s*last_used:\s*([^|\s]*))?/))
      current.helpful = counts[1].to_i
      current.harmful = counts[2].to_i
      current.last_used = counts[3]
    elsif line =~ /\A- \[/
      problems << "lessons.md:#{number}: a lesson starts with `- [L-NNN] Title`"
    end
  end
  problems << "lessons.md:#{current.line}: #{current.id} has no `helpful: N | harmful: N | last_used: ...` line" if current && !current.helpful
  found.group_by(&:id).each { |id, group| problems << "lessons.md: #{id} is used #{group.size} times" if group.size > 1 }
  [found, problems]
end

# -- index ------------------------------------------------------------------

def index_line(note)
  verified = note.fields["verified_at"] ? " (verified #{note.fields['verified_at']})" : ""
  "- #{docs_rel(note.path)} - #{note.fields['summary']}#{verified}"
end

# Every generated file as path => content: docs/INDEX.md, plus one INDEX.md per
# folder when one file would pass index_max_lines.
def index_files
  active = notes.select { |note| note.area != "inbox" && note.area != "archive" && note.fields && note.fields["status"] == "active" }
  groups = TYPE_TITLES.keys.map { |folder| [folder, active.select { |note| note.folder == folder }] }.reject { |_, group| group.empty? }
  proposals = notes.count { |note| note.area == "inbox" }
  lesson_count = lessons.first.size
  head = ["# Index", "", GENERATED, "",
          "Read this at the start of a task and open only the notes that matter to it. Protocol: MEMORY.md."]
  tail = []
  tail += ["", "## Lessons", "- lessons.md - #{lesson_count} lesson(s); skim the titles."] if lesson_count.positive?
  tail += ["", "## Inbox", "- inbox/ - #{proposals} proposal(s) awaiting verification; never guidance."] if proposals.positive?
  body = groups.flat_map { |folder, group| ["", "## #{TYPE_TITLES[folder]}"] + group.map { |note| index_line(note) } }
  body = ["", "No curated notes yet."] if groups.empty?
  files = {}
  if (head + body + tail).size > settings["index_max_lines"]
    body = ["", "## Folders"] + groups.map { |folder, group| "- #{folder}/INDEX.md - #{group.size} #{TYPE_TITLES[folder].downcase} note(s)" }
    groups.each do |folder, group|
      files[File.join(DOCS, folder, "INDEX.md")] =
        (["# #{TYPE_TITLES[folder]} index", "", GENERATED, "", "Paths are relative to docs/.", ""] + group.map { |note| index_line(note) }).join("\n") + "\n"
    end
  end
  files[INDEX] = (head + body + tail).join("\n") + "\n"
  files
end

# Generated folder indexes that the current notes no longer need.
def stale_folder_indexes(wanted)
  Dir.glob(File.join(DOCS, "*", "INDEX.md")).select do |file|
    !wanted.key?(file) && File.read(file).include?(GENERATED)
  end
end

def index_differences
  wanted = index_files
  changed = wanted.reject { |file, content| File.file?(file) && File.read(file) == content }.keys
  changed + stale_folder_indexes(wanted)
end

def write_index
  wanted = index_files
  wanted.each do |file, content|
    if File.file?(file) && !File.read(file).include?(GENERATED) && file != INDEX
      abort "#{rel(file)} exists and was not written by bin/memory index; rename it, then run this again"
    end
    File.write(file, content) unless File.file?(file) && File.read(file) == content
  end
  stale_folder_indexes(wanted).each { |file| File.delete(file) }
  puts "Wrote #{wanted.keys.map { |file| rel(file) }.join(', ')}."
end

# -- lint -------------------------------------------------------------------

def log_problems
  dir = File.join(DOCS, "log")
  return [] unless File.directory?(dir)

  Dir.glob(File.join(dir, "**", "*")).sort.select { |file| File.file?(file) }.each_with_object([]) do |file, problems|
    name = docs_rel(file)
    match = name.match(%r{\Alog/(\d{4})/(\d{2})/(\d{2})/(\d+)-[^/]+\.md\z})
    unless match
      problems << "#{rel(file)}: log entries are named log/YYYY/MM/DD/EPOCH-slug.md"
      next
    end
    day = Time.at(match[4].to_i).utc.strftime("%Y/%m/%d")
    problems << "#{rel(file)}: epoch #{match[4]} is #{day} in UTC, not #{match[1]}/#{match[2]}/#{match[3]}" if day != "#{match[1]}/#{match[2]}/#{match[3]}"
  end
end

def secret_problems
  Dir.glob(File.join(DOCS, "**", "*"), File::FNM_DOTMATCH).sort.select { |file| File.file?(file) }.each_with_object([]) do |file, problems|
    File.foreach(file, encoding: "UTF-8").with_index(1) do |line, number|
      line = line.scrub
      SECRETS.each { |name, pattern| problems << "#{rel(file)}:#{number}: looks like #{name}; remove it and rotate it" if line =~ pattern }
    end
  end
end

def size_problems
  root = %w[CLAUDE.md AGENTS.md].map { |name| File.join(ROOT, name) }.find { |file| File.file?(file) }
  problems = []
  if root
    lines = File.foreach(root).count
    max = settings["root_context_max_lines"]
    problems << "#{rel(root)}: #{lines} lines, over root_context_max_lines (#{max}); move detail into docs/ notes" if lines > max
  end
  if File.file?(INDEX)
    lines = File.foreach(INDEX).count
    max = settings["index_max_lines"]
    problems << "docs/INDEX.md: #{lines} lines, over index_max_lines (#{max})" if lines > max
  end
  problems
end

def lint
  problems = []
  problems << "docs/history/ is a legacy log: migrate it with the project-memory skill" if File.directory?(File.join(DOCS, "history"))
  problems << "docs/HISTORY.md is a legacy log: migrate it with the project-memory skill" if File.file?(File.join(DOCS, "HISTORY.md"))
  ids = {}
  notes.each { |note| (ids[note.fields["id"]] ||= []) << note if note.fields && note.fields["id"].is_a?(String) }
  ids.each { |id, group| problems << "id #{id} is used by #{group.map { |note| rel(note.path) }.join(' and ')}" if group.size > 1 }
  notes.each { |note| note_problems(note, ids).each { |problem| problems << "#{rel(note.path)}: #{problem}" } }
  found, lesson_problems = lessons
  problems.concat(lesson_problems.map { |problem| "docs/#{problem}" })
  problems.concat(link_problems(LESSONS, File.read(LESSONS)).map { |problem| "docs/lessons.md: #{problem}" }) if File.file?(LESSONS)
  problems.concat(log_problems)
  index_differences.each { |file| problems << "#{rel(file)} is out of date: run bin/memory index" }
  problems.concat(size_problems)
  problems.concat(secret_problems)
  if problems.empty?
    puts "Memory docs are clean: #{notes.size} note(s), #{found.size} lesson(s)."
    exit 0
  end
  problems.each { |problem| puts problem }
  puts "#{problems.size} problem(s)."
  exit 1
end

# -- stale ------------------------------------------------------------------

def stale
  today = Date.today
  window = settings["expire_after_days"]
  sections = []
  proposals = notes.select { |note| note.area == "inbox" }.map do |note|
    created = note.fields && date?(note.fields["created"])
    age = created ? "#{(today - created).to_i} day(s) old" : "no created date"
    "- #{rel(note.path)} (#{age}): #{note.fields && note.fields['summary']}"
  end
  sections << ["Inbox proposals to promote or reject", proposals]
  expiring = notes.select { |note| note.area != "inbox" && note.area != "archive" && note.fields && note.fields["status"] == "active" }.map do |note|
    verified = date?(note.fields["verified_at"])
    if !verified
      "- #{rel(note.path)}: no valid verified_at"
    elsif (today - verified).to_i > window
      "- #{rel(note.path)}: verified #{note.fields['verified_at']}, #{(today - verified).to_i} day(s) ago"
    end
  end.compact
  sections << ["Notes not verified in #{window} days: re-verify or expire", expiring]
  harmful = lessons.first.select { |lesson| lesson.harmful.to_i.positive? && lesson.harmful >= lesson.helpful.to_i }
  sections << ["Lessons to retire (harmful >= helpful)", harmful.map { |lesson| "- #{lesson.id} #{lesson.title} (helpful #{lesson.helpful}, harmful #{lesson.harmful})" }]
  sections.reject! { |_, lines| lines.empty? }
  if sections.empty?
    puts "Nothing to consolidate."
  else
    puts sections.map { |title, lines| "#{title}:\n#{lines.join("\n")}" }.join("\n\n")
  end
end

USAGE = "usage: bin/memory lint | index [--check] | stale"

unless File.file?(PROTOCOL)
  warn "bin/memory: no docs/MEMORY.md in #{ROOT}; set up project memory with the project-memory skill"
  exit 1
end

case ARGV
when ["lint"] then lint
when ["index"] then write_index
when ["index", "--check"]
  stale_files = index_differences
  if stale_files.empty?
    puts "docs/INDEX.md is current."
  else
    stale_files.each { |file| puts "#{rel(file)} is out of date: run bin/memory index" }
    exit 1
  end
when ["stale"] then stale
when ["-h"], ["--help"], ["help"] then puts USAGE
else
  warn USAGE
  exit 2
end
