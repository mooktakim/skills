{
  "description": "capture: hint Claude to offer recording a rule when a prompt reads like a correction",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/correction-hint.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
