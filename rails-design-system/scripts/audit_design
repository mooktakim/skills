#!/usr/bin/env ruby
# frozen_string_literal: true

# Report design drift: colours and utilities that bypass the design-system tokens,
# plus the project rules in docs/design-system/audit-rules (see below).
# Plain Ruby, standard library only (Ruby 2.6+): no Bundler, works in any app.
# Works from any directory: paths resolve from the repo root - the script's parent
# directory, or $AUDIT_ROOT when set (the rails-design-system plugin runs its own
# copy against the project this way).
# Findings are drift signals to review, not proof of defects.
# Mark a deliberate exception by putting "design-ok" on the same line.
# Mailer templates are exempt: email clients require inline styles.
#
# Modes:
#   bin/audit_design                    scan the app and report; always exits 0
#   bin/audit_design --strict           the same scan; exits 1 on any finding (CI,
#                                       for apps whose audit is already clean)
#   bin/audit_design --changed <base>   checks only lines added since the merge
#                                       base with <base>; exits 1 on any finding
#                                       (CI for apps that still carry old drift)
#   bin/audit_design --hook             Claude Code PostToolUse hook (Write|Edit):
#                                       reads the tool-call JSON from stdin and
#                                       checks the edited file
#   bin/audit_design --stop             Claude Code Stop/SubagentStop hook: checks
#                                       every view file changed in the working tree,
#                                       which catches edits made through Bash,
#                                       generators, or subagents
# Both hook modes check only lines added since HEAD (the whole file if untracked),
# so old drift elsewhere in a file never blocks an unrelated edit. They exit 2
# with findings on stderr so the agent fixes them before moving on.
#
# Data files (optional, read from docs/design-system/):
#   vendor-paths   one path prefix per line (# comments): sections on the External
#                  library model, where literal palette classes are allowed
#   audit-rules    project rules promoted from design reviews, one per line as
#                  "<label> :: <regular expression>", optionally followed by
#                  " :: <path prefix> <path prefix>..." to limit the rule to one
#                  section's files (# comments); they apply in every mode, and
#                  "design-ok" exempts a line

require "json"

ORIGINAL_DIR = Dir.pwd
ROOT = File.expand_path(ENV["AUDIT_ROOT"] || File.join(__dir__, ".."))
Dir.chdir(ROOT)

# A hex colour never follows a letter, digit, "_", "-", "." or "&": "cart#add" is a
# Stimulus action, "this.#fade" a private JS field, "&#123;" an HTML entity.
HEX = /(^|[^0-9a-zA-Z_.&-])#([0-9a-fA-F]{6}|[0-9a-fA-F]{8}|[0-9a-fA-F]{3,4})([^0-9a-zA-Z_-]|$)/.freeze
# Arbitrary values: w-[260px], bg-[var(--x)], and the v4 shorthand bg-(--x). A
# bracket followed by ":" (or "/name:") is a variant selector such as
# data-[state=open]: - Tailwind grammar, not a value - and passes.
ARB = %r{[a-z][a-z0-9:-]*-(\[[^\]]+\]|\(--[^)]+\))([^:/]|/[0-9]|$)}.freeze
PAL = /(bg|text|border|ring|divide|outline|fill|stroke|from|via|to|accent|decoration|placeholder|caret|shadow)-(slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)-[0-9]{2,3}/.freeze

VIEW_DIRS = %w[app/views app/components app/frontend app/javascript app/assets/stylesheets].freeze
EXTENSIONS = %w[.erb .haml .slim .html .rb .css .js].freeze

def data_lines(name)
  path = File.join("docs/design-system", name)
  return [] unless File.file?(path)

  File.readlines(path, chomp: true).map(&:strip).reject { |line| line.empty? || line.start_with?("#") }
end

VENDOR_PREFIXES = data_lines("vendor-paths").freeze

# Compiles a user rule without Ruby's own warnings (grep-style "[^]]" is valid but
# warns); nil when the pattern is invalid.
def quietly
  verbose = $VERBOSE
  $VERBOSE = nil
  yield
rescue RegexpError
  nil
ensure
  $VERBOSE = verbose
end

RULES = data_lines("audit-rules").each_with_object([]) do |line, rules|
  label, pattern, scope = line.split(" :: ", 3)
  unless pattern
    warn %(audit-rules: no " :: " in "#{line}" - skipped)
    next
  end
  regexp = quietly { Regexp.new(pattern.b) } # bytes: files are read as bytes
  if regexp
    rules << [label.strip, regexp, scope.to_s.split]
  else
    warn %(audit-rules: invalid regex for "#{label.strip}" - skipped)
  end
end.freeze

def rule_applies?(prefixes, path)
  prefixes.empty? || prefixes.any? { |prefix| path.start_with?(prefix) }
end

def vendor?(path)
  VENDOR_PREFIXES.any? { |prefix| path.start_with?(prefix) }
end

def exempt_path?(path)
  path.match?(%r{_mailer/|(^|/)layouts/mailer}) || path.match?(%r{(^|/)(tokens|theme)[^/]*\.css$})
end

def in_scope?(path)
  return false if exempt_path?(path)
  return false unless VIEW_DIRS.any? { |dir| path.start_with?("#{dir}/") }

  EXTENSIONS.include?(File.extname(path))
end

def git(*args)
  IO.popen(["git", *args], err: File::NULL, &:read)
end

def git_ok?(*args)
  system("git", *args, out: File::NULL, err: File::NULL)
end

def text_lines(content)
  lines = content.b.split("\n", -1)
  lines.pop if lines.last == ""
  lines
end

# [line_number, text] for each line added since base (every line if the file is
# new there), without lines marked design-ok.
def added_lines(path, base)
  lines =
    if git_ok?("rev-parse", "-q", "--verify", base) && git_ok?("cat-file", "-e", "#{base}:#{path}")
      number = 0
      text_lines(git("diff", "-U0", base, "--", path)).each_with_object([]) do |line, added|
        if (hunk = line.match(/\A@@ -\S+ \+(\d+)/))
          number = hunk[1].to_i
        elsif number.positive? && line.start_with?("+")
          added << [number, line[1..-1]]
          number += 1
        end
      end
    else
      text_lines(File.binread(path)).each_with_index.map { |text, index| [index + 1, text] }
    end
  lines.reject { |_, text| text.include?("design-ok") }
end

def findings_for(path, base)
  token_check = vendor?(path) ? Regexp.union(HEX, ARB) : Regexp.union(HEX, ARB, PAL)
  lines = added_lines(path, base)
  token_hits = lines.select { |_, text| text.match?(token_check) }.map { |number, text| "  #{path.b}:#{number}: #{text}" }
  rule_hits = RULES.flat_map do |label, pattern, prefixes|
    next [] unless rule_applies?(prefixes, path)

    lines.select { |_, text| text.match?(pattern) }.map { |number, text| "  #{path.b}:#{number}: #{text}   [rule: #{label.b}]" }
  end
  token_hits + rule_hits
end

def changed_paths(base)
  (git("diff", "--name-only", base).split("\n") + git("ls-files", "--others", "--exclude-standard").split("\n")).uniq.sort
end

def changed_findings(base)
  changed_paths(base).select { |path| File.file?(path) && in_scope?(path) }.flat_map { |path| findings_for(path, base) }
end

def block(findings, status: 2, where: "the lines just written")
  message = ["Design-system drift in #{where}:", *findings]
  message << "Untagged lines break the token rule (no raw hex, no literal palette classes, no arbitrary [...] values): use the section's role tokens (see docs/design-system/)."
  if findings.any? { |line| line.include?("[rule: ") }
    message << "Lines tagged [rule: ...] break a project rule in docs/design-system/audit-rules: follow the spec it names."
  end
  message << "For a deliberate exception, put design-ok on that line."
  $stderr.puts(message)
  exit status
end

# The repo-relative path of a tool-call file path, or nil when it is outside the
# repo. Handles relative paths and symlinked roots (/tmp vs /private/tmp).
def repo_relative(file)
  file = File.expand_path(file, ORIGINAL_DIR)
  real_root = File.realpath(ROOT)
  [ROOT, real_root].each do |root|
    return file.delete_prefix("#{root}/") if file.start_with?("#{root}/")
  end
  real = begin
    File.realpath(file)
  rescue SystemCallError
    file
  end
  real.start_with?("#{real_root}/") ? real.delete_prefix("#{real_root}/") : nil
end

def read_json_stdin
  JSON.parse($stdin.read)
rescue JSON::ParserError
  {}
end

def hook_mode
  input = read_json_stdin
  file = input.is_a?(Hash) ? input.dig("tool_input", "file_path").to_s : ""
  return if file.empty?

  path = repo_relative(file)
  return unless path && File.file?(path) && in_scope?(path)

  findings = findings_for(path, "HEAD")
  block(findings) unless findings.empty?
end

def stop_mode
  input = read_json_stdin
  # stop_hook_active means the agent was already sent back once: never loop.
  return if input.is_a?(Hash) && input["stop_hook_active"] == true

  findings = changed_findings("HEAD")
  block(findings) unless findings.empty?
end

def changed_mode(base_ref)
  abort "usage: bin/audit_design --changed <base-branch>" if base_ref.to_s.empty?
  base = git("merge-base", base_ref, "HEAD").strip
  abort "No merge base with #{base_ref} - in CI, check out the full history (fetch-depth: 0)." if base.empty?

  findings = changed_findings(base)
  block(findings, status: 1, where: "lines added since #{base_ref}") unless findings.empty?
  puts "No design drift in lines added since #{base_ref}."
end

def scan_files
  VIEW_DIRS.select { |dir| File.directory?(dir) }.flat_map do |dir|
    Dir.glob("#{dir}/**/*").select { |path| File.file?(path) && EXTENSIONS.include?(File.extname(path)) }.sort
  end.reject { |path| exempt_path?(path) }
end

def full_scan(strict:)
  unless VIEW_DIRS.any? { |dir| File.directory?(dir) }
    puts "No view directories found."
    return
  end

  files = scan_files.map do |path|
    content = File.binread(path)
    next if content.include?("\0")

    lines = text_lines(content).each_with_index.map { |text, index| [index + 1, text] }
    [path, lines.reject { |_, text| text.include?("design-ok") }]
  end.compact

  everywhere = ->(_path) { true }
  checks = [["raw hex colours", HEX, everywhere], ["arbitrary values", ARB, everywhere],
            ["literal palette classes", PAL, ->(path) { !vendor?(path) }]]
  checks += RULES.map { |label, pattern, prefixes| ["rule: #{label}", pattern, ->(path) { rule_applies?(prefixes, path) }] }
  total = 0
  checks.each do |label, pattern, applies|
    hits = files.flat_map do |path, lines|
      next [] unless applies.call(path)

      lines.select { |_, text| text.match?(pattern) }.map { |number, text| "   #{path.b}:#{number}:#{text}" }
    end
    total += hits.size
    puts "== #{label}: #{hits.size}", *hits, ""
  end

  if total.zero?
    puts "No drift detected."
  else
    puts "Fix findings by retokenising the view or adding a token to the section's tokens.md."
    puts "Never quiet a finding by weakening this script; mark deliberate exceptions with design-ok."
    exit 1 if strict
  end
end

case ARGV[0]
when "--hook" then hook_mode
when "--stop" then stop_mode
when "--changed" then changed_mode(ARGV[1])
else full_scan(strict: ARGV[0] == "--strict")
end
