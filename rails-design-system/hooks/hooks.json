{
  "description": "rails-design-system: weekly maintenance notice, and when to delegate to the design-reviewer agent",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/maintenance-nudge.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/reviewer-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
