{
  "description": "rails-design-system: weekly notice when a project's design system is due a maintenance run",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/maintenance-nudge.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
