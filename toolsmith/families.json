{
  "about": "Repeated Bash patterns found in Claude Code transcripts. scripts/analyse counts them, and a tool whose tool.json names a family takes it over: the PreToolUse hook reminds Claude of the tool when a Bash command matches the family. A command matches when every regex of any one rule matches (Ruby regex syntax). The toolsmith skill adds families as scans find new patterns.",
  "families": [
    {
      "id": "literal-replace",
      "title": "a script that replaces literal text in a file",
      "rules": [
        ["\\bpython3?\\b", "open\\([^)]*,\\s*['\"][wa]|write_text|\\.write\\(", "\\.replace\\("],
        ["\\bruby\\b", "File\\.write|IO\\.write|File\\.open\\([^)]*['\"]w", "\\.g?sub!?\\(\\s*['\"]"],
        ["\\bsed\\b[^\\n|;&]*\\s-i\\b", "(?:['\"]|-e\\s+)s([/|#,@])(?:\\\\[./]|(?!\\1)[^\\\\.*^$\\[\\]\\n])+\\1"],
        ["\\bperl\\s+-\\w*i", "(?:['\"]|-e\\s+)s([/|#,@{])(?:\\\\[./]|(?!\\1)[^\\\\.*^$\\[\\]()+?|\\n])+\\1"]
      ]
    },
    {
      "id": "history-write",
      "title": "writing a docs/log history entry by hand",
      "rules": [
        ["docs/(?:history|log)/", "cat\\s*>|mkdir|>\\s*\"?\\$"]
      ]
    },
    {
      "id": "multi-file-heredoc",
      "title": "writing several files with heredocs in one command",
      "rules": [
        ["cat\\s*>\\s*\\S+\\s*<<(?:.|\\n)*cat\\s*>\\s*\\S+\\s*<<"]
      ]
    },
    {
      "id": "ci-wait",
      "title": "waiting for CI or reading its failures",
      "rules": [
        ["\\bgh run watch\\b"],
        ["\\bgh pr checks\\b[^\\n|;&]*--watch"],
        ["\\b(sleep|until|while)\\b", "\\bgh (pr checks|run (list|view))\\b"],
        ["\\bgh run view\\b[^\\n|;&]*--log-failed"]
      ]
    },
    {
      "id": "pr-land",
      "title": "merging a pull request and cleaning up the branch",
      "rules": [
        ["gh pr merge"]
      ]
    },
    {
      "id": "commit-chain",
      "title": "staging, committing and pushing in one command",
      "rules": [
        ["git commit", "git add"]
      ]
    },
    {
      "id": "image-prep",
      "title": "resizing, cropping or stitching images",
      "rules": [
        ["\\bmagick\\b|\\bsips\\b|\\bcwebp\\b"]
      ]
    },
    {
      "id": "json-edit",
      "title": "changing a value in a JSON file with a script",
      "rules": [
        ["\\bjq\\b", ">\\s*\\S+\\.json|mv \\S+ \\S+\\.json"]
      ]
    },
    {
      "id": "conflict-resolve",
      "title": "a script that resolves git merge-conflict blocks in files",
      "rules": [
        ["<<<<<<<|>>>>>>>", "open\\([^)]*,\\s*['\"]w|write_text|File\\.write|IO\\.write|\\bsed\\s+(-[a-zA-Z]*\\s+)*-i|\\bperl\\s+-\\w*i\\b"]
      ]
    },
    {
      "id": "yaml-edit",
      "title": "changing a YAML file with a script",
      "rules": [
        ["\\bYAML\\b|\\byaml\\b|\\.ya?ml\\b", "File\\.write|open\\([^)]*,\\s*['\"]w"]
      ]
    },
    {
      "id": "line-range-read",
      "title": "reading line ranges of files with sed -n",
      "rules": [
        ["sed -n\\s+'?\\d+,\\d+p'?\\s+[^\\s|;&<>]+(?:.|\\n)*sed -n\\s+'?\\d+,\\d+p'?\\s+[^\\s|;&<>]+"]
      ]
    },
    {
      "id": "test-output-trim",
      "title": "running tests or lint and cutting the output with tail, grep or head",
      "rules": [
        ["(?:^|[;&|(]\\s*)(?:bundle exec\\s+)?(?:bin/rails test|rails test|bin/ci|bin/rspec|rspec|bin/rubocop|rubocop|bin/audit_\\w+)\\b[^|\\n]*\\|\\s*(tail|grep|head)"]
      ]
    }
  ]
}
